// Smart College Management System - Database Schema
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  FACULTY
  ADMIN
  BRANCH
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
}

enum NoticeCategory {
  GENERAL
  ACADEMIC
  EXAMINATION
  EVENTS
  HOLIDAY
  PLACEMENT
  EMERGENCY
}

enum NoticePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AcademicUpdateCategory {
  EXAM_SCHEDULE
  ASSIGNMENT
  INTERNAL_ASSESSMENT
  ACADEMIC_CALENDAR
  DEPARTMENT_ANNOUNCEMENT
  IMPORTANT_DEADLINE
}

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  LOST
  FOUND
  CLAIMED
  RESOLVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  CLASS_REMINDER
  NOTICE
  ACADEMIC_UPDATE
  WHATSAPP_REQUEST
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum WhatsAppRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportType {
  STUDENTS
  FACULTY
  TIMETABLE
  MARKS
}

enum ImportStatus {
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

// ============================================================
// CORE USER / ROLE MODELS
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              Role
  avatarUrl         String?   @map("avatar_url")
  isActive          Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  student   Student?
  faculty   Faculty?
  admin     Admin?
  branchAdmin BranchAdmin?

  notifications     Notification[]
  auditLogs         AuditLog[]
  createdNotices    Notice[]         @relation("NoticeCreatedBy")
  createdUpdates    AcademicUpdate[] @relation("UpdateCreatedBy")
  createdLostFound  LostFoundItem[]  @relation("LostFoundCreatedBy")
  moderatedLostFound LostFoundItem[] @relation("LostFoundModeratedBy")
  updatedSettings   Setting[]
  passwordResetCodes PasswordResetCode[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// One row per browser/device a user has enabled notifications on — a user
// can have several (phone + laptop, etc). Endpoint is the unique identity
// the push service (browser vendor) assigns to that subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// A short-lived numeric code for the "forgot password" flow. The code
// itself is hashed at rest (like a password) — even a database leak
// doesn't expose usable codes, since they also expire quickly.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  studentId    String   @unique @map("student_id")
  fullName     String   @map("full_name")
  phone        String
  departmentId String   @map("department_id")
  year         Int
  // Optional finer-grained class marker (1-6) for institutions that track
  // by semester rather than year alone — e.g. year 2 covers semesters 3-4.
  // `year` remains the real grouping field used everywhere else (timetable,
  // marks, dashboards); this is purely informational/display.
  semester     Int?
  section      String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id])
  whatsappRequests WhatsAppRequest[]
  marks           Mark[]

  @@index([departmentId])
  @@map("students")
}

model Faculty {
  id           String        @id @default(cuid())
  userId       String        @unique @map("user_id")
  facultyId    String        @unique @map("faculty_id")
  fullName     String        @map("full_name")
  title        String?       // preferred salutation — "Mr.", "Ms.", "Dr.", "Prof.", etc. Never assumed if unset.
  phone        String
  departmentId String        @map("department_id")
  designation  String
  status       FacultyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department        @relation(fields: [departmentId], references: [id])
  timetableEntries TimetableEntry[]
  classReminders  ClassReminder[]

  @@index([departmentId])
  @@map("faculty")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// A department-scoped admin (HOD / branch coordinator) — same management
// powers as Admin over students/faculty/timetable/marks, but every query is
// server-side restricted to this one department. See branchScope.middleware.ts.
model BranchAdmin {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  branchId     String   @unique @map("branch_id")
  departmentId String   @unique @map("department_id")
  fullName     String   @map("full_name")
  phone        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@map("branch_admins")
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  students     Student[]
  faculty      Faculty[]
  subjects     Subject[]
  updates      AcademicUpdate[]
  timetables   TimetableEntry[]
  branchAdmin  BranchAdmin?

  @@map("departments")
}

model Subject {
  id           String @id @default(cuid())
  name         String
  code         String @unique
  departmentId String @map("department_id")

  department      Department       @relation(fields: [departmentId], references: [id])
  timetableEntries TimetableEntry[]
  marks           Mark[]

  @@map("subjects")
}

model Block {
  id   String @id @default(cuid())
  name String @unique

  rooms      Room[]
  timetables TimetableEntry[]

  @@map("blocks")
}

model Room {
  id      String @id @default(cuid())
  number  String
  blockId String @map("block_id")

  block            Block            @relation(fields: [blockId], references: [id])
  timetableEntries TimetableEntry[]

  @@unique([number, blockId])
  @@map("rooms")
}

// ============================================================
// MARKS (admin-imported internal exam marks — Mid1 / Mid2 / Semester)
// ============================================================

model Mark {
  id           String   @id @default(cuid())
  studentId    String   @map("student_id")
  subjectId    String   @map("subject_id")
  academicYear String   @map("academic_year")
  mid1         Float?   @map("mid1")
  mid2         Float?   @map("mid2")
  semester     Float?   @map("semester")
  importedById String   @map("imported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicYear])
  @@index([studentId])
  @@map("marks")
}

// ============================================================
// NOTICE BOARD
// ============================================================

model Notice {
  id            String         @id @default(cuid())
  title         String
  description   String
  category      NoticeCategory @default(GENERAL)
  priority      NoticePriority @default(NORMAL)
  publishedDate DateTime?      @map("published_date")
  expiryDate    DateTime?      @map("expiry_date")
  attachmentUrl String?        @map("attachment_url")
  isPublished   Boolean        @default(false) @map("is_published")
  createdById   String         @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  createdBy User @relation("NoticeCreatedBy", fields: [createdById], references: [id])

  @@index([isPublished, category])
  @@map("notices")
}

// ============================================================
// ACADEMIC UPDATES
// ============================================================

model AcademicUpdate {
  id            String                  @id @default(cuid())
  title         String
  description   String
  departmentId  String?                 @map("department_id")
  year          Int?
  section       String?
  category      AcademicUpdateCategory  @default(DEPARTMENT_ANNOUNCEMENT)
  date          DateTime
  attachmentUrl String?                 @map("attachment_url")
  createdById   String                  @map("created_by_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  createdBy  User        @relation("UpdateCreatedBy", fields: [createdById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId, year, section])
  @@map("academic_updates")
}

// ============================================================
// LOST & FOUND
// ============================================================

model LostFoundItem {
  id             String          @id @default(cuid())
  itemName       String          @map("item_name")
  description    String
  type           LostFoundType
  location       String
  date           DateTime
  contactInfo    String          @map("contact_info")
  imageUrl       String?         @map("image_url")
  status         LostFoundStatus @default(LOST)
  createdById    String          @map("created_by_id")
  moderatedById  String?         @map("moderated_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  createdBy   User  @relation("LostFoundCreatedBy", fields: [createdById], references: [id])
  moderatedBy User? @relation("LostFoundModeratedBy", fields: [moderatedById], references: [id])

  @@index([status, type])
  @@map("lost_found_items")
}

// ============================================================
// TIMETABLE
// ============================================================

model TimetableEntry {
  id           String    @id @default(cuid())
  facultyId    String    @map("faculty_id")
  subjectId    String    @map("subject_id")
  departmentId String    @map("department_id")
  year         Int
  section      String
  day          DayOfWeek
  startTime    String    @map("start_time") // "HH:mm" 24h
  endTime      String    @map("end_time")   // "HH:mm" 24h
  roomId       String    @map("room_id")
  blockId      String    @map("block_id")
  academicYear String    @map("academic_year")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  faculty        Faculty         @relation(fields: [facultyId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  department     Department      @relation(fields: [departmentId], references: [id])
  room           Room            @relation(fields: [roomId], references: [id])
  block          Block           @relation(fields: [blockId], references: [id])
  classReminders ClassReminder[]

  @@index([facultyId, day])
  @@index([departmentId, year, section, day])
  @@index([roomId, day])
  @@map("timetable_entries")
}

model ClassReminder {
  id                String          @id @default(cuid())
  timetableEntryId  String          @map("timetable_entry_id")
  facultyId         String          @map("faculty_id")
  classDate         DateTime        @map("class_date") @db.Date
  notificationType  String          @default("FIVE_MIN_BEFORE") @map("notification_type")
  scheduledFor      DateTime        @map("scheduled_for")
  sentAt            DateTime?       @map("sent_at")
  status            ReminderStatus  @default(SCHEDULED)
  createdAt         DateTime        @default(now()) @map("created_at")

  timetableEntry TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  faculty        Faculty        @relation(fields: [facultyId], references: [id])

  @@unique([timetableEntryId, classDate, notificationType])
  @@map("class_reminders")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  title       String
  message     String
  type        NotificationType    @default(SYSTEM)
  status      NotificationStatus  @default(UNREAD)
  relatedType String?             @map("related_type")
  relatedId   String?             @map("related_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

// ============================================================
// SETTINGS (fee link, results link, etc.)
// ============================================================

model Setting {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ============================================================
// WHATSAPP GROUPS & REQUESTS
// ============================================================

model WhatsAppGroup {
  id         String   @id @default(cuid())
  name       String
  subject    String
  department String?
  year       Int?
  section    String?
  inviteLink String   @map("invite_link")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  requests WhatsAppRequest[]

  @@map("whatsapp_groups")
}

model WhatsAppRequest {
  id          String                 @id @default(cuid())
  studentId   String                 @map("student_id")
  department  String
  year        Int
  section     String
  phone       String
  groupId     String                 @map("group_id")
  reason      String
  status      WhatsAppRequestStatus  @default(PENDING)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  student Student       @relation(fields: [studentId], references: [id])
  group   WhatsAppGroup @relation(fields: [groupId], references: [id])

  @@index([status])
  @@map("whatsapp_requests")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// IMPORT BATCHES (tracks CSV / image imports for review)
// ============================================================

model ImportBatch {
  id          String       @id @default(cuid())
  type        ImportType
  fileName    String       @map("file_name")
  status      ImportStatus
  totalRows   Int          @default(0) @map("total_rows")
  successRows Int          @default(0) @map("success_rows")
  failedRows  Int          @default(0) @map("failed_rows")
  errors      Json?
  importedById String      @map("imported_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("import_batches")
}
