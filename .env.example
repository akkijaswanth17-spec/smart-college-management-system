# ============================================================
# Smart College Management System — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:DevPassword123!@localhost:5432/smart_college?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# College timezone (IANA tz name) — used by the reminder scheduler
COLLEGE_TIMEZONE="Asia/Kolkata"

# File uploads
UPLOAD_DIR="../uploads"
MAX_UPLOAD_MB=5

# Optional: email (not required for core functionality)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: WhatsApp class-reminder messages (5 minutes before each class).
# Leave WHATSAPP_PROVIDER blank to keep this a no-op — reminders still work
# as in-app notifications either way. Set it to "twilio" or "meta" once you
# have real credentials from that provider, and fill in only that section.
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- if WHATSAPP_PROVIDER=twilio ---
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=

# --- if WHATSAPP_PROVIDER=meta ---
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# Web Push — real, free browser/phone notifications, no third-party account.
# Generate your own pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT="mailto:office@example.edu"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
