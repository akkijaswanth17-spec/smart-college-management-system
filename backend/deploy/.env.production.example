# Production environment for the deployed VM. Copy to the project root as
# `.env` on the server (NOT committed to git — same rule as local dev).

# From Neon: Dashboard → your project → Connection string (use the "pooled" one)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/smart_college?sslmode=require"

JWT_SECRET="generate-a-new-long-random-secret-do-not-reuse-the-dev-one"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=production

# The real deployed frontend URL (e.g. Vercel) — required for CORS + cookies to work.
FRONTEND_URL="https://your-app.vercel.app"

COLLEGE_TIMEZONE="Asia/Kolkata"

UPLOAD_DIR="../uploads"
MAX_UPLOAD_MB=5

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Web Push — reuse the SAME keys from your local .env (do not regenerate;
# regenerating invalidates every browser subscription already saved).
VAPID_SUBJECT="mailto:office@mictech.ac.in"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=
